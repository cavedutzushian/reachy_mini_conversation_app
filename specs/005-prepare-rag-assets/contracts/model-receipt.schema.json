{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pinned BGE-M3 local model receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model_id", "revision", "resolved_revision", "files", "runtime", "verification"],
  "properties": {
    "schema_version": {"const": 1},
    "model_id": {"const": "BAAI/bge-m3"},
    "revision": {"$ref": "#/$defs/revision"},
    "resolved_revision": {"$ref": "#/$defs/revision"},
    "files": {
      "type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "size_bytes", "sha256"],
        "properties": {
          "path": {"enum": ["config.json", "config_sentence_transformers.json", "modules.json", "sentence_bert_config.json", "1_Pooling/config.json", "sentencepiece.bpe.model", "special_tokens_map.json", "tokenizer.json", "tokenizer_config.json", "model.safetensors"]},
          "size_bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["sentence_transformers_version", "torch_version", "transformers_version"],
      "properties": {
        "sentence_transformers_version": {"$ref": "#/$defs/packageVersion"},
        "torch_version": {"$ref": "#/$defs/packageVersion"},
        "transformers_version": {"$ref": "#/$defs/packageVersion"}
      }
    },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["query", "embedding"],
      "properties": {
        "query": {"const": "這份文件主要說明什麼？"},
        "embedding": {"type": "array", "minItems": 1024, "maxItems": 1024, "items": {"type": "number"}}
      }
    }
  },
  "$defs": {
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "packageVersion": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[0-9][a-zA-Z0-9.+_-]*$"}
  }
}
