{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Single-document prebuilt Chroma package manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "index_version", "document", "engine", "producer", "validated_targets", "snapshot_complete", "chunk_count", "files", "embedding", "retrieval", "reference"],
  "properties": {
    "schema_version": {"const": 1},
    "index_version": {"$ref": "#/$defs/identifier"},
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "version", "source_sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "title": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
        "version": {"$ref": "#/$defs/identifier"},
        "source_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "collection"],
      "properties": {
        "name": {"const": "chromadb"},
        "version": {"$ref": "#/$defs/packageVersion"},
        "collection": {"type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*[a-zA-Z0-9]$"}
      }
    },
    "producer": {"$ref": "#/$defs/target"},
    "validated_targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/target"}},
    "snapshot_complete": {"const": true},
    "chunk_count": {"type": "integer", "minimum": 1},
    "files": {"$ref": "#/$defs/fileInventory"},
    "embedding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "revision", "files", "sentence_transformers_version", "torch_version", "transformers_version", "mode", "dimension", "precision", "pooling", "normalize", "query_prefix", "document_prefix", "max_seq_length", "metric"],
      "properties": {
        "model_id": {"const": "BAAI/bge-m3"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "files": {"$ref": "#/$defs/fileInventory"},
        "sentence_transformers_version": {"$ref": "#/$defs/packageVersion"},
        "torch_version": {"$ref": "#/$defs/packageVersion"},
        "transformers_version": {"$ref": "#/$defs/packageVersion"},
        "mode": {"const": "dense"},
        "dimension": {"const": 1024},
        "precision": {"const": "float32"},
        "pooling": {"const": "cls"},
        "normalize": {"const": true},
        "query_prefix": {"const": ""},
        "document_prefix": {"const": ""},
        "max_seq_length": {"const": 8192},
        "metric": {"const": "cosine"}
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_distance"],
      "properties": {"max_distance": {"type": "number", "minimum": 0, "maximum": 2}}
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query", "embedding"],
      "properties": {
        "query": {"type": "string", "minLength": 1, "maxLength": 500},
        "embedding": {"type": "array", "minItems": 1024, "maxItems": 1024, "items": {"type": "number"}}
      }
    }
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "packageVersion": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[0-9][a-zA-Z0-9.+_-]*$"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture"],
      "properties": {
        "os": {"enum": ["windows", "linux", "macos"]},
        "architecture": {"enum": ["x86_64", "aarch64"]}
      }
    },
    "fileInventory": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\:\\u0000-\\u001f\\u007f]+(?:/[^/\\\\:\\u0000-\\u001f\\u007f]+)*$"},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  }
}
